# Build artefacts — regenerated by `make`, never committed.
build/
*.vvp
*.vcd

# Exception: preserved bug evidence. Never fix an interesting bug before
# capturing the waveform that proves it — see docs/README.md.
!docs/bugs/**/*.vcd

# macOS
.DS_Store

# Editor state — a recommendation list, not a build input.
.vscode/

# ------------------------------------------------------------------
# Captured operational data — NEVER commit.
# Decision 0001 and 0004: stimulus is synthesised from published
# protocol specs. A real trace is optional realism for the arrival
# model only, held outside this repository. The FleetPoynt trace is
# live GPS history of real vehicles; it does not enter version control.
# ------------------------------------------------------------------
*.pcap
*.pcapng
traces/
bench/traces/
*.trace

# Third-party reference source — see reference/README.md to refetch.
# Apache-2.0, pinned by commit. Read-only, not part of the build.
reference/*.java
reference/*.pdf
